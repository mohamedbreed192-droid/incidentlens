# Copy to .env, then replace the two REPLACE values. Do not commit .env.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_DATABASE_PASSWORD
# Compose uses the db hostname; for a host-side process use localhost:55432 instead.
DATABASE_URL=postgresql+psycopg://incidentlens:REPLACE_WITH_RANDOM_LOCAL_DATABASE_PASSWORD@db:5432/incidentlens
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ENV=development
# Local HTTP only. Production requires true and an HTTPS ALLOWED_ORIGIN.
SESSION_SECURE=false
ALLOWED_ORIGIN=http://localhost:8000
# baseline never contacts a model. openai is explicit opt-in and may incur provider charges.
ANALYSIS_MODE=baseline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PROVIDER_TIMEOUT=12
